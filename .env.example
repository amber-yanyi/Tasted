NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Wine label recognition. Server-side only — do NOT prefix with NEXT_PUBLIC_,
# or the key ends up in the browser bundle.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# gemini-2.5-flash-lite is closed to new API keys (404 on call, despite still
# being listed by the models endpoint) and retires 2026-10-16. 3.1-flash-lite
# is the current cheapest vision model: $0.25/$1.50 per 1M tokens, about
# $0.0005 per label.
GEMINI_MODEL=gemini-3.1-flash-lite

# Public origin, used to build absolute URLs in link-preview metadata.
# Without it Next falls back to the Vercel deployment hostname.
NEXT_PUBLIC_SITE_URL=https://www.tasted.app
